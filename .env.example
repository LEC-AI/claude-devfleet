# Copy to .env (git-ignored); start.sh loads it.

# Night Shift window, local time in DEVFLEET_NIGHT_TZ (IANA name, e.g. Asia/Kolkata)
DEVFLEET_NIGHT_TZ=Europe/London
DEVFLEET_NIGHT_START=20:00
DEVFLEET_NIGHT_END=08:00

# Max agents running at once (all projects)
DEVFLEET_MAX_AGENTS=3

# Ports. On a shared machine each person needs their own pair.
DEVFLEET_PORT=18801
DEVFLEET_UI_PORT=3100
